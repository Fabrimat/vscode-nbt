{
	"name": "vscode-nbt-plus",
	"displayName": "NBT Plus for VS Code",
	"description": "View and edit Minecraft NBT (Java & Bedrock) with a 3D structure viewer for .nbt, .mcstructure, .litematic, .schem and .schematic files, plus region (.mca) support",
	"version": "1.0.0",
	"publisher": "Fabrimat",
	"repository": {
		"type": "git",
		"url": "https://github.com/Fabrimat/vscode-nbt.git"
	},
	"engines": {
		"vscode": "^1.66.0"
	},
	"categories": [
		"Visualization",
		"Other"
	],
	"activationEvents": [
		"onCustomEditor:vscodeNbtPlus.editor"
	],
	"main": "./out/extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"customEditors": [
			{
				"viewType": "vscodeNbtPlus.editor",
				"displayName": "NBT Editor",
				"selector": [
					{
						"filenamePattern": "*.nbt"
					},
					{
						"filenamePattern": "*.dat"
					},
					{
						"filenamePattern": "*.dat_old"
					},
					{
						"filenamePattern": "*.mca"
					},
					{
						"filenamePattern": "*.mcstructure"
					},
					{
						"filenamePattern": "*.schematic"
					},
					{
						"filenamePattern": "*.litematic"
					},
					{
						"filenamePattern": "*.schem"
					}
				],
				"priority": "default"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run build",
		"build": "rollup --config",
		"dev": "rollup --config --watch",
		"lint": "eslint . --ext .ts",
		"package": "vsce package"
	},
	"dependencies": {
		"deepslate": "^0.26.1",
		"env-paths": "^2.2.1",
		"follow-redirects": "^1.16.3",
		"gl-matrix": "^3.4.3",
		"tar": "^7.5.22",
		"vscode-codicons": "^0.0.14"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^20.0.0",
		"@rollup/plugin-node-resolve": "^13.0.6",
		"@rollup/plugin-typescript": "^8.5.0",
		"@types/follow-redirects": "^1.14.0",
		"@types/node": "^22.20.5",
		"@types/vscode": "^1.46.0",
		"@typescript-eslint/eslint-plugin": "^5.3.1",
		"@typescript-eslint/parser": "^5.3.1",
		"@vscode/vsce": "^4.1.0",
		"eslint": "^8.2.0",
		"ovsx": "^1.4.0",
		"rollup": "^2.59.0",
		"ts-node": "^10.4.0",
		"typescript": "^5.9.3"
	},
	"license": "MIT",
	"icon": "res/icon.png",
	"homepage": "https://github.com/Fabrimat/vscode-nbt#readme",
	"bugs": {
		"url": "https://github.com/Fabrimat/vscode-nbt/issues"
	},
	"keywords": [
		"minecraft",
		"nbt",
		"snbt",
		"mcstructure",
		"bedrock",
		"litematic",
		"schematic",
		"schem",
		"region",
		"mca",
		"structure",
		"3d"
	],
	"galleryBanner": {
		"color": "#1e1e1e",
		"theme": "dark"
	}
}
